# Local dev DB (docker compose up -d). Copy to .env
DATABASE_URL=postgresql://app:app@localhost:5432/payload_start
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Directory where uploaded media is stored (defaults to ./media)
MEDIA_DIR=

# Fallback site URL for sitemap/canonical when Site Settings > SEO > Site URL is empty
NEXT_PUBLIC_SITE_URL=
